<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#2B3E50"
        tools:context=".MainActivity">

    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

            <!-- Cabeçalho (Título) -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp">

                <TextView
                        android:id="@+id/titulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PORT"
                        android:textSize="32sp"
                        android:textColor="#8BBBE1"
                        android:fontFamily="@font/alfa_slab_one" />

                <TextView
                        android:id="@+id/titulo2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="folio"
                        android:textSize="40sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="cursive"
                        android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Separador / Subtítulo -->
            <TextView
                    android:id="@+id/subTitulo4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Teus Trabalhos"
                    android:textColor="#D1E5F7"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="12dp"
                    android:background="#1E3040"
                    android:layout_marginBottom="16dp" />

            <!-- Botões de Ação -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                <Button
                        android:id="@+id/btTrabalhos"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Trabalhos"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#3A6B94"
                        android:fontFamily="@font/amaranth_bold"
                        android:textSize="14sp"
                        android:layout_marginEnd="6dp" />

                <Button
                        android:id="@+id/btNovoTrabalho"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Novo Trabalho"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#3A6B94"
                        android:fontFamily="@font/amaranth_bold"
                        android:textSize="14sp"
                        android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Container Lista de Trabalhos -->
            <LinearLayout
                    android:id="@+id/layTrabalhos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:minHeight="300dp" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>